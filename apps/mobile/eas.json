{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "environment": "preview",
      "env": { "SENTRY_ALLOW_FAILURE": "true" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "SENTRY_ALLOW_FAILURE": "true" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "W4MAPA8GZ7",
        "ascAppId": "6834605241"
      }
    },
    "testflight": {
      "ios": {
        "appleTeamId": "W4MAPA8GZ7",
        "ascAppId": "6834605241"
      }
    }
  }
}
